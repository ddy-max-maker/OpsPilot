# 统一换行符：仓库内一律 LF，避免 Windows CRLF 混入
* text=auto eol=lf

# 源码与配置强制 LF
*.py text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.ico binary

# 脚本可执行位
*.sh text eol=lf
