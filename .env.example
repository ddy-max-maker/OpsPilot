# ===== 数据库（SQLAlchemy 异步连接串，Docker Compose 内主机名为 postgres）=====
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot

# ===== JWT 签名密钥（生产必须替换为足够随机的值；缺失时服务拒绝启动）=====
JWT_SECRET=change-me-to-a-long-random-secret

# ===== 可选：cursor 分页签名密钥（缺省复用 JWT_SECRET）=====
# CURSOR_SECRET=

# ===== 初始 Admin 引导（三者须同时提供；全不提供则跳过引导并打印警告）=====
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeImmediately_1

# ===== Webhook 告警接入（CONTRACTS §5：HMAC-SHA256 签名 + timestamp 防重放）=====
# 与外部告警源共享的密钥（生产必须替换；缺失时服务拒绝启动）
WEBHOOK_ALERTS_SECRET=change-me-to-a-long-random-webhook-secret
# 时间戳重放窗口（秒；默认 ±300）
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ===== API 幂等键保留时长（小时；契约冻结值：24）=====
IDEMPOTENCY_TTL_HOURS=24

# ===== D2：Agent 模型 Provider（部署期锁定；模型名不写死在业务层）=====
# fake = 确定性脚本模型（CI/无凭据演示，报告由真实工具结果合成）
# anthropic | google | deepseek = 真实模型（需设置 AGENT_API_KEY_ENV 指向含 Key 的环境变量名）
AGENT_PROVIDER=fake
AGENT_MODEL_NAME=fake-diagnoser
# D6：内置 fake 模型必须显式开启（默认 false = 不回退假模型，缺凭据直接报错）
# CI / 本地 E2E 需设为 true；生产部署保持 false
AGENT_FAKE_PROVIDER_ENABLED=true
# AGENT_API_KEY_ENV=DEEPSEEK_API_KEY
# OpenAI 兼容自定义 API 地址（deepseek 缺省官方 https://api.deepseek.com/v1，无需填写）
# AGENT_API_BASE=
AGENT_PROMPT_VERSION=d4-v1
# DeepSeek API Key（本地 .env 保存，禁止提交；此处仅示例变量名）
# DEEPSEEK_API_KEY=
# D3：MySQL 只读诊断账号密码（连接器经 password_env 间接引用，不入 Git）
# D3_MYSQL_RO_PASSWORD=

# ===== D4：知识库与 RAG =====
# off = 关闭 RAG（D3 行为）| text-only = 全文/关键词 | hybrid = 全文 + pgvector 向量（RRF 融合）
RAG_MODE=off
# local_e5 = 本地 intfloat/multilingual-e5-small（384 维，需 uv sync --group embedding）
# fake = 确定性哈希向量（CI，不联网）
EMBEDDING_PROVIDER=local_e5

# ===== D5：RabbitMQ 与受控执行 =====
# RabbitMQ 凭据（compose 强制要求密码；生产必须替换默认用户）
RABBITMQ_USER=opspilot
RABBITMQ_PASSWORD=change-me-rabbitmq-password
# API/Worker 侧连接串（容器内主机名 rabbitmq）
# RABBITMQ_URL=amqp://opspilot:change-me-rabbitmq-password@localhost:5672/%2F
# ops-action 执行器实例标识与容器 allowlist 前缀（演示环境兜底隔离）
ACTION_EXECUTOR_ID=ops-action-1
ACTION_CONTAINER_NAME_PREFIX=opspilot-demo-
# D6 安全门禁：真实动作执行默认关闭（demo-only）。仅在专用隔离演示
# Daemon 上显式置 true 才允许 restart 等副作用动作
ACTION_EXECUTION_ENABLED=false
# 隔离环境确认（D6 收尾）：与上面同时为 true 才真正启用真实写操作。
# ops-action 挂载的宿主 docker.sock 是高权限凭据，应用层 allowlist 不是基础设施
# 级隔离；置 true 表示已确认指向独立演示 Daemon 并接受该残余风险
ACTION_ISOLATED_DAEMON_ACK=false
# 可选：受控恢复专用 Docker socket（指向独立隔离演示 Daemon；留空用容器内默认）
# ACTION_DOCKER_SOCKET=/var/run/docker-demo.sock
# 恢复验证窗口（秒）：观察总时长 / 探测间隔 / 最少连续通过次数
VERIFICATION_OBSERVATION_WINDOW_SECONDS=30
VERIFICATION_PROBE_INTERVAL_SECONDS=5
VERIFICATION_MIN_PASSING_PROBES=3

# ===== D2：Run 预算默认值（服务端硬限制）=====
BUDGET_MAX_TOOL_CALLS=24
BUDGET_MAX_ITERATIONS=40
BUDGET_MAX_TOKENS=200000
BUDGET_DEADLINE_SECONDS=900

# ===== D2：Worker（DB 认领 + 租约）=====
WORKER_LEASE_TTL_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=2

# ===== D2：checkpoint 保留天数（随 run 终态清理）=====
CHECKPOINT_RETENTION_DAYS=30

# ===== Access Token 有效期（分钟；契约冻结值：30，首版无 Refresh Token）=====
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== 分页默认值（契约：limit <= 200）=====
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
